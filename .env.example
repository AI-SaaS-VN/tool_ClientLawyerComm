# Template only — copy to .env and fill in real values locally.
# Never commit a real .env (it is git-ignored).

# PostgreSQL (matches docker-compose.yml local dev defaults)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/clc_dev?schema=public"

# MinIO / S3-compatible private object storage
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="clc-dev-uploads"

# App
NEXT_PUBLIC_APP_NAME="ClientLawyerComm"

# Outbound email (MVP: operator mailbox via SMTP; address/code live only in real .env)
SMTP_HOST="smtp.qq.com"
SMTP_PORT="587"
SMTP_SECURE="starttls"
SMTP_USER="your-mailbox@example.com"
SMTP_AUTH_CODE="your-smtp-authorization-code"
EMAIL_FROM="your-mailbox@example.com"
