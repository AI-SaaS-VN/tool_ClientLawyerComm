generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  displayName      String            @map("display_name")
  globalRole       String            @map("global_role") @default("client")
  status           String            @default("active")
  preferredLang    String?           @map("preferred_lang")
  uiLang           String?           @map("ui_lang")
  mfaSecretRef     String?           @map("mfa_secret_ref")
  mfaEnrolledAt    DateTime?         @map("mfa_enrolled_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  sessions         Session[]
  channels         ContactChannel[]
  memberships      CaseMember[]
  invitesCreated   Invite[]          @relation("InviteCreator")
  casesCreated     Case[]            @relation("CaseCreator")
  clientProfiles   ClientProfile[]
  caseApplications CaseApplication[] @relation("ApplicationLawyer")
  decidedApplications CaseApplication[] @relation("ApplicationDecider")
  messagesAuthored  Message[] @relation("MessageAuthor")
  messagesCorrected Message[] @relation("MessageCorrector")
  reviewTasksAssigned ReviewTask[]
  reviewTasksDecided ReviewTask[] @relation("ReviewTaskDecider")
  notificationTasksReceived NotificationTask[]
  notificationTasksSent NotificationTask[] @relation("UrgentAlertSender")
  filesUploaded    File[]            @relation("FileUploader")

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime  @map("expires_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  revokedAt    DateTime? @map("revoked_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model ContactChannel {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String         @default("email")
  valueEnc      String         @map("value_enc")
  valueHash     String         @unique @map("value_hash")
  verifiedAt    DateTime?      @map("verified_at")
  isPrimary     Boolean        @default(false) @map("is_primary")
  notifyEnabled Boolean        @default(true) @map("notify_enabled")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  otpChallenges OtpChallenge[]
  notificationTasks NotificationTask[]

  @@index([userId])
  @@map("contact_channels")
}

model OtpChallenge {
  id          String         @id @default(uuid()) @db.Uuid
  channelId   String         @map("channel_id") @db.Uuid
  channel     ContactChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  purpose     String         @default("login")
  codeHash    String         @map("code_hash")
  expiresAt   DateTime       @map("expires_at")
  attempts    Int            @default(0)
  lockedUntil DateTime?      @map("locked_until")
  usedAt      DateTime?      @map("used_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([channelId, createdAt])
  @@map("otp_challenges")
}

model Case {
  id            String       @id @default(uuid()) @db.Uuid
  title         String
  refNo         String?      @map("ref_no")
  alias         String?
  clientOrgName String       @map("client_org_name")
  status        String       @default("active")
  createdBy     String?      @map("created_by") @db.Uuid
  creator       User?        @relation("CaseCreator", fields: [createdBy], references: [id])
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  members       CaseMember[]
  invites       Invite[]
  messages      Message[]
  reviewTasks   ReviewTask[]
  notificationTasks NotificationTask[]
  files         File[]
  digestRuns    DigestRun[]

  @@map("cases")
}

model CaseMember {
  id           String    @id @default(uuid()) @db.Uuid
  caseId       String    @map("case_id") @db.Uuid
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberRole   String    @map("member_role")
  canManage    Boolean   @default(false) @map("can_manage")
  canReview    Boolean   @default(false) @map("can_review")
  isBackup     Boolean   @default(false) @map("is_backup")
  status       String    @default("active")
  revokedAt    DateTime? @map("revoked_at")
  digestOptOut Boolean   @default(false) @map("digest_opt_out")
  lastReadMessageId String? @map("last_read_message_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([caseId, userId])
  @@index([userId])
  @@map("case_members")
}

model ClientProfile {
  id        String   @id @default(uuid()) @db.Uuid
  lawyerId  String   @map("lawyer_id") @db.Uuid
  lawyer    User     @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  name      String
  note      String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications CaseApplication[]

  @@index([lawyerId])
  @@map("client_profiles")
}

model CaseApplication {
  id              String        @id @default(uuid()) @db.Uuid
  lawyerId        String        @map("lawyer_id") @db.Uuid
  lawyer          User          @relation("ApplicationLawyer", fields: [lawyerId], references: [id], onDelete: Cascade)
  clientProfileId String        @map("client_profile_id") @db.Uuid
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  summary         String
  status          String        @default("pending")
  decidedBy       String?       @map("decided_by") @db.Uuid
  decider         User?         @relation("ApplicationDecider", fields: [decidedBy], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([lawyerId])
  @@index([status])
  @@map("case_applications")
}

model Invite {
  id         String    @id @default(uuid()) @db.Uuid
  codeHash   String    @unique @map("code_hash")
  sentToEnc  String    @map("sent_to_enc")
  caseId     String    @map("case_id") @db.Uuid
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  role       String
  expiresAt  DateTime? @map("expires_at")
  usedAt     DateTime? @map("used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String    @map("created_by") @db.Uuid
  creator    User      @relation("InviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([caseId])
  @@map("invites")
}

model Message {
  id             String    @id @default(uuid()) @db.Uuid
  caseId         String    @map("case_id") @db.Uuid
  case           Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId       String    @map("author_id") @db.Uuid
  author         User      @relation("MessageAuthor", fields: [authorId], references: [id])
  idempotencyKey String    @map("idempotency_key")
  sourceLang     String    @map("source_lang")
  sourceText     String    @map("source_text")
  status         String    @default("pending_check")
  seq            Int       @unique @default(autoincrement())
  publishedAt    DateTime? @map("published_at")
  correctedById  String?   @map("corrected_by_id") @db.Uuid
  correctedBy    User?     @relation("MessageCorrector", fields: [correctedById], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  translations   TranslationVersion[]

  @@unique([caseId, authorId, idempotencyKey])
  @@index([caseId, status, publishedAt])
  @@map("messages")
}

// One row per translation attempt; revisions/retries insert a higher version
// and never overwrite older rows (REQ-TR-04). Status/target_lang CHECKs are
// hand-added in the migration. State machine: SPEC 5.2.
model TranslationVersion {
  id            String   @id @default(uuid()) @db.Uuid
  messageId     String   @map("message_id") @db.Uuid
  message       Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  targetLang    String   @map("target_lang")
  version       Int
  text          String?
  status        String   @default("queued")
  provider      String?
  model         String?
  promptVersion String?  @map("prompt_version")
  keyFieldCheck String?  @map("key_field_check")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([messageId, targetLang, version])
  @@index([messageId, targetLang])
  @@map("translation_versions")
}

// target_id is polymorphic (message now, file in T08) and carries no FK.
// Status/target_type/reason CHECK constraints are hand-added in the migration.
model ReviewTask {
  id              String    @id @default(uuid()) @db.Uuid
  caseId          String    @map("case_id") @db.Uuid
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  targetType      String    @map("target_type")
  targetId        String    @map("target_id") @db.Uuid
  assigneeId      String?   @map("assignee_id") @db.Uuid
  assignee        User?     @relation(fields: [assigneeId], references: [id])
  status          String    @default("open")
  reason          String
  escalationLevel Int       @default(0) @map("escalation_level")
  openedAt        DateTime? @map("opened_at")
  startedAt       DateTime? @map("started_at")
  decidedAt       DateTime? @map("decided_at")
  decidedById     String?   @map("decided_by_id") @db.Uuid
  decidedBy       User?     @relation("ReviewTaskDecider", fields: [decidedById], references: [id])
  decisionReason  String?   @map("decision_reason")
  selfRelease     Boolean   @default(false) @map("self_release")
  appealNote      String?   @map("appeal_note")
  appealedAt      DateTime? @map("appealed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  notificationTasks NotificationTask[]

  @@index([caseId, status])
  @@index([targetType, targetId])
  @@map("review_tasks")
}

// Persistent notification queue (SPEC 10.1 state machine). kind/status CHECKs
// are hand-added in the migration; 'peer_urgent'/'check_failed_alert' kinds
// are registered by T08/T10, 'urgent_failed_alert' by T10 (REQ-NTF-05 final-
// failure notice to can_review coordinators), 'case_digest' by T13 (REQ-DIG). sender_user_id is set on
// peer_urgent tasks so the sender can track delivery status (REQ-NTF-04).
// recipient_channel_id is nullable: a recipient without a verified email
// channel still gets a row (status failed, last_error no_channel) so the
// anomaly is visible (REQ-NTF-12).
model NotificationTask {
  id                 String          @id @default(uuid()) @db.Uuid
  kind               String
  caseId             String          @map("case_id") @db.Uuid
  case               Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  reviewTaskId       String?         @map("review_task_id") @db.Uuid
  reviewTask         ReviewTask?     @relation(fields: [reviewTaskId], references: [id], onDelete: Cascade)
  senderUserId       String?         @map("sender_user_id") @db.Uuid
  sender             User?           @relation("UrgentAlertSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  recipientUserId    String          @map("recipient_user_id") @db.Uuid
  recipientUser      User            @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientChannelId String?         @map("recipient_channel_id") @db.Uuid
  recipientChannel   ContactChannel? @relation(fields: [recipientChannelId], references: [id], onDelete: SetNull)
  status             String          @default("queued")
  dedupeKey          String          @unique @map("dedupe_key")
  attempts           Int             @default(0)
  nextRetryAt        DateTime?       @map("next_retry_at")
  providerRef        String?         @map("provider_ref")
  lastError          String?         @map("last_error")
  submittedAt        DateTime?       @map("submitted_at")
  confirmedAt        DateTime?       @map("confirmed_at")
  cancelledAt        DateTime?       @map("cancelled_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([status, nextRetryAt])
  @@index([caseId, kind])
  @@index([reviewTaskId])
  @@index([senderUserId])
  @@map("notification_tasks")
}

// REQ-DIG-05: one row per (case, Vietnam calendar day) generation — the
// unique (case_id, digest_date) makes daily generation idempotent across
// worker restarts and 10s ticks. digest_date is the Asia/Ho_Chi_Minh calendar
// date stored as text YYYY-MM-DD (a DATE column would surface as UTC midnight
// and invite off-by-one bugs). recipients_json = { emailed: userId[],
// skipped: { userId, reason }[] }; error doubles as the skip reason
// (empty_day / no_verified_coordinator / case_archived). body_text and
// parts_json freeze the rendered digest at generation so a later
// republication cannot change an already-queued digest; parts_json is the
// deterministic file→part assignment [{ part, fileIds }].
model DigestRun {
  id             String   @id @default(uuid()) @db.Uuid
  caseId         String   @map("case_id") @db.Uuid
  case           Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  digestDate     String   @map("digest_date")
  status         String   @default("queued")
  recipientsJson Json     @map("recipients_json")
  parts          Int      @default(0)
  error          String?
  bodyText       String?  @map("body_text")
  partsJson      Json?    @map("parts_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([caseId, digestDate])
  @@map("digest_runs")
}

// Append-only (no updated_at). REQ-OPS-01: operator, action, target, case,
// result, time — never message bodies, attachment bytes, OTPs, tokens, or
// registered contact channels (meta_json included). actor_id/target_id are
// polymorphic and carry no FKs, like review_tasks.target_id.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id") @db.Uuid
  caseId     String?  @map("case_id") @db.Uuid
  result     String
  metaJson   Json?    @map("meta_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// Status state machine: SPEC 8.1 (status CHECK is hand-added in the
// migration). storage_key points into the private quarantine prefix and is
// never exposed through API views (REQ-FILE-02); originals are immutable —
// orig_hash/uploader/time are set once at upload (REQ-FILE-04).
model File {
  id           String    @id @default(uuid()) @db.Uuid
  caseId       String    @map("case_id") @db.Uuid
  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploaderId   String    @map("uploader_id") @db.Uuid
  uploader     User      @relation("FileUploader", fields: [uploaderId], references: [id])
  status       String    @default("uploaded")
  origHash     String    @map("orig_hash")
  storageKey   String    @map("storage_key")
  mime         String
  sizeBytes    Int       @map("size_bytes")
  originalName String    @map("original_name")
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  variants     FileVariant[]

  @@index([caseId, status])
  @@map("files")
}

// kind CHECK is hand-added in the migration ('original'/'shared_copy';
// 'bilingual' is P1 and not created). Shared copies are stored separately
// from the original and linked back via source_version (REQ-FILE-04).
model FileVariant {
  id            String   @id @default(uuid()) @db.Uuid
  fileId        String   @map("file_id") @db.Uuid
  file          File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  kind          String
  version       Int
  storageKey    String   @map("storage_key")
  sourceVersion Int?     @map("source_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([fileId, kind, version])
  @@map("file_variants")
}
